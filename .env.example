# Copy to .env.local and adjust. All variables are optional.

# Base URL prepended to every API request. Leave empty to call /api on the same origin.
VITE_API_BASE_URL=

# "true" starts the Mock Service Worker so the app runs without a backend.
# Set to "false" once a real backend that implements docs/api-contract.md is available.
VITE_ENABLE_MOCKS=true

# Optional URL that receives error reports as JSON via navigator.sendBeacon.
# Leave empty to only log to the console.
VITE_LOG_ENDPOINT=
