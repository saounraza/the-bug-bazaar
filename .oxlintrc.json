{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Use request() from src/api/client.ts. Components never call the network directly."
      },
      {
        "name": "WebSocket",
        "message": "Use the stock feed in src/api/stockFeed.ts."
      },
      {
        "name": "XMLHttpRequest",
        "message": "Use request() from src/api/client.ts."
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist", "public/mockServiceWorker.js"],
  "overrides": [
    {
      "files": [
        "src/api/client.ts",
        "src/api/stockFeed.ts",
        "src/mocks/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["perf/**", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
